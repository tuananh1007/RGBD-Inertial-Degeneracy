+    bool reject = gate_chi2 > 0.0 && gate_d2 > gate_chi2;
+    printf("[VIOGATE] t %.3f d2 %.3f drot %.5f dpos %.5f srot %.5f spos %.5f npts %d reject %d\n", img_time, gate_d2,
