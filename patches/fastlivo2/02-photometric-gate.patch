   double img_point_cov, outlier_threshold, ncc_thre;
+  // Photometric consistency gate: reject an update whose pose correction lies outside the
+  // chi-square region gate_chi2 of the prior (depth-inertial) covariance; 0 disables the gate.
+  double gate_chi2 = 0.0, gate_d2 = 0.0;
+  int gate_rejected = 0;
   
   SubSparseMap *visual_submap;
