+           std::sqrt(P6.bottomRightCorner<3, 3>().trace()), total_points, (int)reject);
+    if (reject)
+    {
+      *state = prior;
+      updateFrameState(*state);
+      gate_rejected++;
+    }
+  }
 
   double t3 = omp_get_wtime();
 
