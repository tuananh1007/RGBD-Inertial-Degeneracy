@@ -1807,7 +1807,24 @@
 
   double t2 = omp_get_wtime();
 
+  StatesGroup prior = *state;
   computeJacobianAndUpdateEKF(img);
+  if (total_points > 0)
+  {
+    VD(6) d6 = ((*state) - prior).head<6>();
+    MD(6, 6) P6 = prior.cov.topLeftCorner<6, 6>();
