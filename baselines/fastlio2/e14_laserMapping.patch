+/*** restricted correction after the iterated update (e14_restriction.hpp) ***/
+int    e14_mode = 0;          // 0 off (logs the isotropy only), 1 Joseph P_L, 2 splice P_S, 3 unrestricted posterior P_K
+double e14_tau = 0.0, e14_inflate = 1.0;
+ofstream e14_traj;
+
+void e14_restrict(const state_ikfom &x_prop, const esekfom::esekf<state_ikfom, 12, input_ikfom>::cov &P_prop)
+{
+    M3D F = M3D::Zero(), Pi_t, Q_t;
+    for (int i = 0; i < effct_feat_num; i++)
+    {
+        V3D n(corr_normvect->points[i].x, corr_normvect->points[i].y, corr_normvect->points[i].z);
+        F += n * n.transpose();
+    }
+    double iso;
+    const int n_obs = e14::projector(F, e14_tau, Pi_t, Q_t, iso);
+    printf("[E14] t %.3f feats %d iso %.5f obs %d\n", lidar_end_time - first_lidar_time, effct_feat_num, iso, n_obs);
+    fflush(stdout);   // the container is killed at the end of a run
+    if (e14_mode == 0 || n_obs == 3) return;
+
+    esekfom::esekf<state_ikfom, 12, input_ikfom>::cov P = kf.get_P(), Pi, PL, PS;
+    state_ikfom x = kf.get_x();
+    const V3D dp = x.pos - x_prop.pos;
+    x.pos = x_prop.pos + Pi_t * dp;   // position only; rotation, velocity, biases keep the update
+    Pi.setIdentity();
+    Pi.block<3, 3>(0, 0) = Pi_t;
+    e14::covariances(P_prop, P, Pi, PL, PS);
+    if (e14_mode != 3) P = e14_mode == 1 ? PL : PS;
+    if (e14_inflate > 1.0)   // suppressed position directions, position block only (as oc_cov_inflate)
+    {
+        const M3D T = M3D::Identity() + (e14_inflate - 1.0) * Q_t;
+        P.block<3, 3>(0, 0) = T * P.block<3, 3>(0, 0) * T.transpose();
+    }
+    const M3D P_pos = P.block<3, 3>(0, 0);
+    printf("[E14P] t %.3f dp %.4e dropped %.4e dPF %.4e pvar %.4e\n", lidar_end_time - first_lidar_time, dp.norm(),
+           (Q_t * dp).norm(), (PS - PL).norm(), Eigen::SelfAdjointEigenSolver<M3D>(P_pos).eigenvalues()(2));
+    fflush(stdout);
+    kf.change_x(x);
+    kf.change_P(P);
+}
